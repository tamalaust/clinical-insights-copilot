# Path to the raw dataset CSV
RAW_DATA_PATH=data/raw/diabetic_data.csv

# Path to the ID mapping CSV
IDS_MAPPING_PATH=data/raw/IDS_mapping.csv

# Postgres connection string — adjust user/password to match your local setup
DATABASE_URL=postgresql+psycopg2://youruser@localhost:5432/clinical_insights

# Name of the cleaned table the ETL writes to
CLEANED_TABLE_NAME=encounters_cleaned

# Ollama (local) — OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
#FAST API URL
FASTAPI_BASE_URL=http://localhost:8000
#REDIS URL
REDIS_URL=redis://localhost:6379/0
